        approved_leave_clean["employee_id"] == employee
    ]

    for _, leave_row in employee_leave.iterrows():

        if (
            leave_row["start_date"]
            <= day
            <= leave_row["end_date"]
        ):
            return False

    return True


capacity_rows = []

for _, target_row in weekly_targets_df.iterrows():

    employee = target_row["employee_id"]

    week_key = (
        int(target_row["iso_year"]),
        int(target_row["iso_week"])
    )

    week_dates = week_groups[week_key]

    available_dates = [
        day
        for day in week_dates
        if employee_available(employee, day)
    ]

    available_days = len(available_dates)

    # One shift per day, with the longest shift being 8 hours
    maximum_possible_hours = available_days * 8

    target_hours = int(
        target_row["target_hours"]
    )

    capacity_rows.append({

        "employee_id": employee,

        "iso_week": week_key[1],

        "target_hours": target_hours,

        "available_days": available_days,

        "maximum_possible_hours": maximum_possible_hours,

        "possible_before_rest_rules":
            maximum_possible_hours >= target_hours
    })


capacity_check_df = pd.DataFrame(capacity_rows)

impossible_capacity_df = capacity_check_df[
    capacity_check_df[
        "possible_before_rest_rules"
    ] == False
].copy()


print("=" * 70)
print("EMPLOYEE WEEKLY CAPACITY CHECK")
print("=" * 70)

if impossible_capacity_df.empty:

    print(
        "No immediate employee-hour contradictions found."
    )

else:

    print(
        "These employee-weeks cannot meet their "
        "contracted-hour targets:"
    )

    display(impossible_capacity_df)
# ==========================================================
# CELL 15 - SOFT CONSTRAINTS
# ==========================================================

# Reset the objective penalty list
penalty_terms = []


# ----------------------------------------------------------
# Penalty weights
# ----------------------------------------------------------
#
# Higher weight = more important for the solver to avoid.
#
# Requested leave is given the highest priority.
# Closing and weekend fairness are lower-priority preferences.

REQUESTED_LEAVE_WEIGHT = 100
CLOSING_FAIRNESS_WEIGHT = 10
WEEKEND_FAIRNESS_WEIGHT = 5


# ----------------------------------------------------------
# Prepare employee contract groups
# ----------------------------------------------------------

contract_hours_lookup = (
    employees_df
    .set_index("employee_id")["contract_hours"]
    .astype(int)
    .to_dict()
)


contract_groups = {}

for employee in employees:

    contract_hours = contract_hours_lookup[employee]

    contract_groups.setdefault(
        contract_hours,
        []
    ).append(employee)


# ==========================================================
# SC01 - Requested Leave
# ==========================================================
#
# Requested leave is not guaranteed.
#
# If the solver schedules an employee during requested leave,
# a large penalty is added to the objective.

requested_leave_df = leave_df[
    leave_df["status"]
    .astype(str)
    .str.strip()
    .str.upper()
    == "REQUESTED"
].copy()


requested_leave_assignments = 0


for _, leave_row in requested_leave_df.iterrows():

    employee = leave_row["employee_id"]

    leave_start = pd.Timestamp(
        leave_row["start_date"]
    ).normalize()

    leave_end = pd.Timestamp(
        leave_row["end_date"]
    ).normalize()

    # Ignore leave records for employees not in the rota
    if employee not in employees:
        continue

    for day in schedule_dates:

        rota_day = pd.Timestamp(day).normalize()

        if leave_start <= rota_day <= leave_end:

            for shift in shifts:

                penalty_terms.append(
                    REQUESTED_LEAVE_WEIGHT
                    * work[(employee, day, shift)]
                )

                requested_leave_assignments += 1


# ==========================================================
# SC02 - Fair Distribution of Closing Duties
# ==========================================================
#
# Both full and short closing shifts count as closing duties.
#
# Fairness is compared only between employees with the same
# weekly contracted hours.

closing_shifts = [
    "CLOSE",
    "SHORT_CLOSE"
]


closing_duty_counts = {}

closing_spread_variables = []


for employee in employees:

    closing_duty_counts[employee] = sum(

        work[(employee, day, shift)]

        for day in schedule_dates
        for shift in closing_shifts
    )


for contract_hours, group_employees in contract_groups.items():

    if len(group_employees) <= 1:
        continue

    maximum_closing_duties = model.NewIntVar(
        0,
        len(schedule_dates),
        f"max_closing_{contract_hours}h"
    )

    minimum_closing_duties = model.NewIntVar(
        0,
        len(schedule_dates),
        f"min_closing_{contract_hours}h"
    )

    for employee in group_employees:

        model.Add(
            closing_duty_counts[employee]
            <= maximum_closing_duties
        )

        model.Add(
            closing_duty_counts[employee]
            >= minimum_closing_duties
        )

    closing_spread = model.NewIntVar(
        0,
        len(schedule_dates),
        f"closing_spread_{contract_hours}h"
    )

    model.Add(
        closing_spread
        == maximum_closing_duties
        - minimum_closing_duties
    )

    penalty_terms.append(
        CLOSING_FAIRNESS_WEIGHT
        * closing_spread
    )

    closing_spread_variables.append(
        closing_spread
    )


# ==========================================================
# SC03 - Fair Distribution of Weekend Work
# ==========================================================
#
# A weekend duty means working any shift on a Saturday
# or Sunday.
#
# Cell 7 permits only one shift per employee per day, so one
# weekend date can contribute at most one weekend duty.

weekend_dates = [

    day for day in schedule_dates

    if pd.Timestamp(day).weekday() in [5, 6]
]


weekend_duty_counts = {}

weekend_spread_variables = []


for employee in employees:

    weekend_duty_counts[employee] = sum(

        work[(employee, day, shift)]

        for day in weekend_dates
        for shift in shifts
    )


for contract_hours, group_employees in contract_groups.items():

    if len(group_employees) <= 1:
        continue

    maximum_weekend_duties = model.NewIntVar(
        0,
        len(weekend_dates),
        f"max_weekend_{contract_hours}h"
    )

    minimum_weekend_duties = model.NewIntVar(
        0,
        len(weekend_dates),
        f"min_weekend_{contract_hours}h"
    )

    for employee in group_employees:

        model.Add(
            weekend_duty_counts[employee]
            <= maximum_weekend_duties
        )

        model.Add(
            weekend_duty_counts[employee]
            >= minimum_weekend_duties
        )

    weekend_spread = model.NewIntVar(
        0,
        len(weekend_dates),
        f"weekend_spread_{contract_hours}h"
    )

    model.Add(
        weekend_spread
        == maximum_weekend_duties
        - minimum_weekend_duties
    )

    penalty_terms.append(
        WEEKEND_FAIRNESS_WEIGHT
        * weekend_spread
    )

    weekend_spread_variables.append(
        weekend_spread
    )


# ----------------------------------------------------------
# Validation output
# ----------------------------------------------------------

print("=" * 60)
print("SOFT CONSTRAINTS ADDED")
print("=" * 60)

print(
    f"Requested Leave Periods       : "
    f"{len(requested_leave_df)}"
)

print(
    f"Requested Leave Variables     : "
    f"{requested_leave_assignments}"
)

print(
    f"Contract Groups               : "
    f"{len(contract_groups)}"
)

print(
    f"Closing Fairness Measures     : "
    f"{len(closing_spread_variables)}"
)

print(
    f"Weekend Fairness Measures     : "
    f"{len(weekend_spread_variables)}"
)

print(
    f"Total Objective Terms         : "
    f"{len(penalty_terms)}"
)


print("\nPenalty weights:")

print(
    f"Requested Leave               : "
    f"{REQUESTED_LEAVE_WEIGHT}"
)

print(
    f"Closing Fairness              : "
    f"{CLOSING_FAIRNESS_WEIGHT}"
)

print(
    f"Weekend Fairness              : "
    f"{WEEKEND_FAIRNESS_WEIGHT}"
)


print("\nContract groups:")

for contract_hours, group_employees in sorted(
    contract_groups.items()
):

    print(
        f"{contract_hours} hours: "
        f"{len(group_employees)} employees"
    )
# ==========================================================
# CELL 16 - OBJECTIVE FUNCTION
# ==========================================================

# Minimise all soft-constraint penalties created in Cell 15

if len(penalty_terms) == 0:

    raise ValueError(
        "No penalty terms were created. "
        "Run Cell 15 before running this cell."
    )


model.Minimize(
    sum(penalty_terms)
)


print("=" * 60)
print("OBJECTIVE FUNCTION CREATED")
print("=" * 60)

print(f"Penalty Terms Included : {len(penalty_terms)}")

print("\nObjective priorities:")

print(
    f"1. Requested leave avoidance "
    f"(weight {REQUESTED_LEAVE_WEIGHT})"
)

print(
    f"2. Closing-duty fairness "
    f"(weight {CLOSING_FAIRNESS_WEIGHT})"
)

print(
    f"3. Weekend-duty fairness "
    f"(weight {WEEKEND_FAIRNESS_WEIGHT})"
)
# ==========================================================
# CELL 17 - SOLVE THE MODEL
# ==========================================================

solver = cp_model.CpSolver()


# ----------------------------------------------------------
# Solver settings
# ----------------------------------------------------------

# Maximum time allowed for the solver
solver.parameters.max_time_in_seconds = 120

# Use multiple CPU cores where available
solver.parameters.num_search_workers = 8

# Show solver progress in the notebook output
solver.parameters.log_search_progress = True


# ----------------------------------------------------------
# Solve
# ----------------------------------------------------------

print("=" * 60)
print("SOLVING ROTA MODEL")
print("=" * 60)

status = solver.Solve(model)


# ----------------------------------------------------------
# Interpret solver result
# ----------------------------------------------------------

status_name = solver.StatusName(status)

print("\n" + "=" * 60)
print("SOLVER RESULT")
print("=" * 60)

print(f"Status              : {status_name}")
print(f"Solve Time          : {solver.WallTime():.2f} seconds")
print(f"Conflicts           : {solver.NumConflicts()}")
print(f"Branches            : {solver.NumBranches()}")


if status in [
    cp_model.OPTIMAL,
    cp_model.FEASIBLE
]:

    print(f"Objective Value     : {solver.ObjectiveValue():.2f}")
    print(f"Best Objective Bound: {solver.BestObjectiveBound():.2f}")

    if status == cp_model.OPTIMAL:

        print(
            "\nThe solver found the best possible rota "
            "under the current hard and soft constraints."
        )

    else:

        print(
            "\nThe solver found a valid rota, but it may not "
            "be the best possible rota within the time limit."
        )


elif status == cp_model.INFEASIBLE:

    print(
        "\nThe model is infeasible."
    )

    print(
        "This means no rota can satisfy all current hard "
        "constraints at the same time."
    )

    print(
        "\nPossible causes include:"
    )

    print(
        "- insufficient manager availability;"
    )

    print(
        "- insufficient till-trained, opening or closing staff;"
    )

    print(
        "- exact contracted hours conflicting with leave "
        "or unavailability;"
    )

    print(
        "- minimum 12 employees per day being too high;"
    )

    print(
        "- 12-hour rest and weekly-rest requirements reducing "
        "available coverage."
    )


elif status == cp_model.MODEL_INVALID:

    print(
        "\nThe model is invalid."
    )

    print(
        "Check the constraints, variable definitions and "
        "objective function."
    )


else:

    print(
        "\nThe solver did not find a solution within the "
        "allowed time."
    )
# ==========================================================
# CELL 18 - EXTRACT THE SOLVED ROTA
# ==========================================================

rota_records = []


# ----------------------------------------------------------
# Create employee information lookups from the Excel sheet
# ----------------------------------------------------------

employee_name_lookup = (
    employees_df
    .set_index("employee_id")["employee_name"]
    .to_dict()
)

employee_role_lookup = (
    employees_df
    .set_index("employee_id")["role"]
    .to_dict()
)

employee_contract_hours_lookup = (
    employees_df
    .set_index("employee_id")["contract_hours"]
    .astype(int)
    .to_dict()
)

employee_contract_type_lookup = (
    employees_df
    .set_index("employee_id")["contract_type"]
    .to_dict()
)


# ----------------------------------------------------------
# Extract the rota only when a solution exists
# ----------------------------------------------------------

if status in (
    cp_model.OPTIMAL,
    cp_model.FEASIBLE
):

    for employee in employees:

        for day in schedule_dates:

            assigned_shift = "OFF"
            assigned_hours = 0

            for shift in shifts:

                if solver.Value(
                    work[(employee, day, shift)]
                ) == 1:

                    assigned_shift = shift

                    assigned_hours = (
                        shift_details[shift]["hours"]
                    )

                    break


            rota_records.append({

                "employee_id":
                    employee,

                "employee_name":
                    employee_name_lookup[employee],

                "role":
                    employee_role_lookup[employee],

                "contract_hours":
                    employee_contract_hours_lookup[employee],

                "contract_type":
                    employee_contract_type_lookup[employee],

                "date":
                    pd.Timestamp(day).date(),

                "day_name":
                    pd.Timestamp(day).day_name(),

                "shift":
                    assigned_shift,

                "hours":
                    assigned_hours
            })


    # ------------------------------------------------------
    # Create the rota dataframe
    # ------------------------------------------------------

    rota_df = pd.DataFrame(
        rota_records
    )


    # Sort the table into a clear order
    rota_df = (
        rota_df
        .sort_values(
            by=[
                "employee_id",
                "date"
            ]
        )
        .reset_index(drop=True)
    )


    # ------------------------------------------------------
    # Display the result
    # ------------------------------------------------------

    print("=" * 60)
    print("ROTA TABLE CREATED")
    print("=" * 60)

    print(
        f"Employees included : "
        f"{rota_df['employee_id'].nunique()}"
    )

    print(
        f"Rota days included : "
        f"{rota_df['date'].nunique()}"
    )

    print(
        f"Rows created       : "
        f"{len(rota_df):,}"
    )

    print(
        f"Working shifts     : "
        f"{(rota_df['shift'] != 'OFF').sum():,}"
    )

    print("=" * 60)

    display(
        rota_df.head(30)
    )


else:

    print("=" * 60)
    print("ROTA COULD NOT BE EXTRACTED")
    print("=" * 60)

    print(
        "The solver did not find a feasible solution."
    )

    print(
        "Solver status:",
        solver.StatusName(status)
    )
# ==========================================================
# CELL 19 - DISPLAY A SEPARATE ROTA TABLE FOR EACH WEEK
# ==========================================================

if status not in (
    cp_model.OPTIMAL,
    cp_model.FEASIBLE
):

    print(
        "Weekly rota tables cannot be created because "
        "the solver did not find a feasible solution."
    )

else:

    # ------------------------------------------------------
    # Create a copy so the original rota_df is unchanged
    # ------------------------------------------------------

    weekly_rota_df = rota_df.copy()

    weekly_rota_df["date"] = pd.to_datetime(
        weekly_rota_df["date"]
    )


    # ------------------------------------------------------
    # Add ISO year and week number
    # ------------------------------------------------------

    iso_calendar = (
        weekly_rota_df["date"]
        .dt
        .isocalendar()
    )

    weekly_rota_df["iso_year"] = (
        iso_calendar["year"]
        .astype(int)
    )

    weekly_rota_df["iso_week"] = (
        iso_calendar["week"]
        .astype(int)
    )


    # ------------------------------------------------------
    # Add shift start and end times
    # These are taken from the shift definitions already
    # used by the optimisation model
    # ------------------------------------------------------

    weekly_rota_df["shift_start"] = (
        weekly_rota_df["shift"]
        .map(
            lambda shift:
                shift_details[shift]["start"]
                if shift != "OFF"
                else 99
        )
    )

    weekly_rota_df["shift_end"] = (
        weekly_rota_df["shift"]
        .map(
            lambda shift:
                shift_details[shift]["end"]
                if shift != "OFF"
                else 99
        )
    )


    # ------------------------------------------------------
    # Create readable shift times
    # ------------------------------------------------------

    weekly_rota_df["shift_time"] = (
        weekly_rota_df.apply(
            lambda row:
                (
                    f"{int(row['shift_start']):02d}:00"
                    f" - "
                    f"{int(row['shift_end']):02d}:00"
                )
                if row["shift"] != "OFF"
                else "OFF",
            axis=1
        )
    )


    # ------------------------------------------------------
    # Keep only employees who are working
    # OFF employees are excluded from the operational table
    # ------------------------------------------------------

    working_rota_df = weekly_rota_df[
        weekly_rota_df["shift"] != "OFF"
    ].copy()


    # ------------------------------------------------------
    # Find all weeks in chronological order
    # ------------------------------------------------------

    rota_weeks = (
        working_rota_df[
            ["iso_year", "iso_week"]
        ]
        .drop_duplicates()
        .sort_values(
            by=[
                "iso_year",
                "iso_week"
            ]
        )
    )


    weekly_rota_tables = {}


    # ------------------------------------------------------
    # Create and display one table for each week
    # ------------------------------------------------------

    for week_number, week_row in enumerate(
        rota_weeks.itertuples(index=False),
        start=1
    ):

        iso_year = week_row.iso_year
        iso_week = week_row.iso_week

        week_df = working_rota_df[
            (
                working_rota_df["iso_year"]
                == iso_year
            )
            &
            (
                working_rota_df["iso_week"]
                == iso_week
            )
        ].copy()


        # Sort each day from earliest shift to latest shift
        week_df = (
            week_df
            .sort_values(
                by=[
                    "date",
                    "shift_start",
                    "shift_end",
                    "role",
                    "employee_name"
                ]
            )
            .reset_index(drop=True)
        )


        # Add a staff position number for each shift
        week_df["staff_number"] = (
            week_df
            .groupby(
                [
                    "date",
                    "shift"
                ]
            )
            .cumcount()
            + 1
        )


        # Format the date for easier reading
        week_df["display_date"] = (
            week_df["date"]
            .dt
            .strftime("%d/%m/%Y")
        )


        # Select the columns to display
        week_display_df = week_df[
            [
                "display_date",
                "day_name",
                "shift",
                "shift_time",
                "staff_number",
                "employee_id",
                "employee_name",
                "role",
                "contract_hours",
                "hours"
            ]
        ].copy()


        week_display_df = week_display_df.rename(
            columns={
                "display_date": "date",
                "day_name": "day",
                "shift": "shift",
                "shift_time": "shift_time",
                "staff_number": "staff_no",
                "employee_id": "employee_id",
                "employee_name": "employee_name",
                "role": "role",
                "contract_hours": "weekly_contract",
                "hours": "shift_hours"
            }
        )


        # Save each weekly table in a dictionary
        weekly_rota_tables[
            (iso_year, iso_week)
        ] = week_display_df


        week_start = week_df["date"].min()
        week_end = week_df["date"].max()


        print("\n")
        print("=" * 100)

        print(
            f"ROTA WEEK {week_number} "
            f"| ISO WEEK {iso_week}, {iso_year}"
        )

        print(
            f"{week_start.strftime('%A %d %B %Y')} "
            f"to "
            f"{week_end.strftime('%A %d %B %Y')}"
        )

        print("=" * 100)

        display(
            week_display_df
        )


    print("\n")
    print("=" * 60)
    print("WEEKLY ROTA TABLES CREATED")
    print("=" * 60)

    print(
        f"Number of weekly tables: "
        f"{len(weekly_rota_tables)}"
    )
