# CELL 12 - LH05: Minimum 12-Hour Rest
# ==========================================================

MINIMUM_REST_HOURS = 12

# Sort dates to ensure consecutive-day comparisons
sorted_schedule_dates = sorted(schedule_dates)

# Store incompatible shift combinations for checking
incompatible_shift_pairs = []

constraints_added = 0


# ----------------------------------------------------------
# Identify shift combinations that provide less than
# 12 hours of rest between consecutive days
# ----------------------------------------------------------

for previous_shift in shifts:

    previous_end_time = shift_details[previous_shift]["end"]

    for next_shift in shifts:

        next_start_time = shift_details[next_shift]["start"]

        # The next shift begins on the following calendar day
        rest_hours = (
            24
            - previous_end_time
            + next_start_time
        )

        if rest_hours < MINIMUM_REST_HOURS:

            incompatible_shift_pairs.append({
                "previous_shift": previous_shift,
                "next_shift": next_shift,
                "rest_hours": rest_hours
            })


# ----------------------------------------------------------
# Add constraints for each employee and consecutive day
# ----------------------------------------------------------

for employee in employees:

    for day_index in range(len(sorted_schedule_dates) - 1):

        current_day = sorted_schedule_dates[day_index]
        next_day = sorted_schedule_dates[day_index + 1]

        # Only compare genuinely consecutive calendar dates
        if (
            pd.Timestamp(next_day)
            - pd.Timestamp(current_day)
        ).days != 1:

            continue

        for pair in incompatible_shift_pairs:

            previous_shift = pair["previous_shift"]
            next_shift = pair["next_shift"]

            # The employee cannot work both shifts
            model.Add(
                work[(employee, current_day, previous_shift)]
                + work[(employee, next_day, next_shift)]
                <= 1
            )

            constraints_added += 1


incompatible_shift_pairs_df = pd.DataFrame(
    incompatible_shift_pairs
)


print("=" * 60)
print("LH05 - MINIMUM 12-HOUR REST ADDED")
