# CELL 11 - LH04: Contracted Working Hours
# ==========================================================
#
# Contract hours are treated as a hard weekly target.
# Approved leave reduces the number of hours that must be
# physically worked during that week.
#
# This prevents contradictions such as requiring an employee
# to work 40 hours while they are on approved leave all week.

contract_hours_lookup = (
    employees_df
    .set_index("employee_id")["contract_hours"]
    .astype(int)
    .to_dict()
)


# ----------------------------------------------------------
# Keep only approved leave records
# ----------------------------------------------------------

approved_leave_df = leave_df[
    leave_df["status"]
    .astype(str)
    .str.strip()
    .str.upper()
    == "APPROVED"
].copy()


# Create a set of approved leave dates for every employee
approved_leave_dates = {
    employee: set()
    for employee in employees
}


for _, leave_row in approved_leave_df.iterrows():

    employee = leave_row["employee_id"]

    if employee not in approved_leave_dates:
        continue

    leave_days = pd.date_range(
        start=leave_row["start_date"],
        end=leave_row["end_date"]
    )

    approved_leave_dates[employee].update(
        leave_day.date()
        for leave_day in leave_days
    )


# ----------------------------------------------------------
# Group rota dates by ISO year and ISO week
# ----------------------------------------------------------

week_groups = {}

for day in schedule_dates:

    iso_calendar = pd.Timestamp(day).isocalendar()

    week_key = (
        int(iso_calendar.year),
        int(iso_calendar.week)
    )

    week_groups.setdefault(
        week_key,
        []
    ).append(day)


# ----------------------------------------------------------
# Add weekly contracted-hours constraints
# ----------------------------------------------------------

constraints_added = 0
weekly_targets = []


for employee in employees:

    weekly_contract_hours = int(
        contract_hours_lookup[employee]
    )

    for week_key, week_dates in week_groups.items():

        days_in_rota_week = len(week_dates)

        approved_leave_days = sum(
            day in approved_leave_dates[employee]
            for day in week_dates
        )

        schedulable_days = (
            days_in_rota_week
            - approved_leave_days
        )

        # Reduce weekly working hours in proportion to the
        # number of rota days available after approved leave.
        proportional_hours = (
            weekly_contract_hours
            * schedulable_days
            / 7
        )

        # Round to the nearest 4 hours because the shortest
        # available shift is 4 hours.
        target_hours = int(
            round(proportional_hours / 4) * 4
        )

        # Under the one-shift-per-day rule, an employee can
        # work a maximum of 8 hours per schedulable day.
        maximum_possible_hours = (
            schedulable_days * 8
        )

        target_hours = min(
            target_hours,
            maximum_possible_hours
        )

        total_weekly_hours = sum(
            work[(employee, day, shift)]
            * shift_details[shift]["hours"]
            for day in week_dates
            for shift in shifts
        )

        model.Add(
            total_weekly_hours == target_hours
        )

        constraints_added += 1

        weekly_targets.append({
            "employee_id": employee,
            "iso_year": week_key[0],
            "iso_week": week_key[1],
            "days_in_period": days_in_rota_week,
            "approved_leave_days": approved_leave_days,
            "schedulable_days": schedulable_days,
            "weekly_contract": weekly_contract_hours,
            "target_hours": target_hours
        })


