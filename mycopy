def employee_available(employee, day):

    day = pd.Timestamp(day).date()
    weekday = pd.Timestamp(day).strftime("%A").lower()

    # Check recurring weekday unavailability
    if employee in unavailability_lookup:

        unavailable = unavailability_lookup[
            employee
        ].get(weekday, False)

        if bool(unavailable):
            return False

    # Check approved leave
