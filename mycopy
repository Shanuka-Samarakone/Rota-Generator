# ==========================================================
# CELL 3: DEFINE THE ROTA PERIOD
# ==========================================================

# The rota should begin on a Monday so that every rota week
# runs cleanly from Monday to Sunday.

START_DATE = pd.Timestamp("2026-08-03")

# Change this value depending on the rota length:
# 4  = 28-day test rota
# 12 = 12-week rota
# 52 = full 52-week rota (364 days)

NUMBER_OF_WEEKS = 4


# ----------------------------------------------------------
# VALIDATION
# ----------------------------------------------------------

if NUMBER_OF_WEEKS < 1:
    raise ValueError(
        "NUMBER_OF_WEEKS must be at least 1."
    )

if START_DATE.day_name() != "Monday":
    raise ValueError(
        f"START_DATE must be a Monday. "
        f"{START_DATE.date()} is a "
        f"{START_DATE.day_name()}."
    )


# ----------------------------------------------------------
# GENERATE THE ROTA DATES
# ----------------------------------------------------------

NUMBER_OF_DAYS = NUMBER_OF_WEEKS * 7

schedule_dates = [
    START_DATE + pd.Timedelta(days=day_offset)
    for day_offset in range(NUMBER_OF_DAYS)
]


# ----------------------------------------------------------
# CREATE THE CALENDAR TABLE
# ----------------------------------------------------------

calendar_df = pd.DataFrame({
    "date": pd.to_datetime(schedule_dates)
})

calendar_df["weekday"] = (
    calendar_df["date"].dt.day_name()
)

calendar_df["iso_year"] = (
    calendar_df["date"]
    .dt.isocalendar()
    .year
    .astype(int)
)

calendar_df["iso_week"] = (
    calendar_df["date"]
    .dt.isocalendar()
    .week
    .astype(int)
)

calendar_df["week_key"] = list(
    zip(
        calendar_df["iso_year"],
        calendar_df["iso_week"]
    )
)

calendar_df["is_weekend"] = (
    calendar_df["weekday"]
    .isin(["Saturday", "Sunday"])
)


# ----------------------------------------------------------
# VALIDATE THE GENERATED CALENDAR
# ----------------------------------------------------------

expected_end_date = (
    START_DATE
    + pd.Timedelta(days=NUMBER_OF_DAYS - 1)
)

if schedule_dates[-1] != expected_end_date:
    raise RuntimeError(
        "The rota end date was generated incorrectly."
    )

if schedule_dates[-1].day_name() != "Sunday":
    raise RuntimeError(
        "The rota period does not finish on a Sunday."
    )

generated_weeks = (
    calendar_df["week_key"]
    .drop_duplicates()
    .tolist()
)

if len(generated_weeks) != NUMBER_OF_WEEKS:
    raise RuntimeError(
        "The generated number of ISO weeks does not "
        "match NUMBER_OF_WEEKS."
    )


# ----------------------------------------------------------
# DISPLAY THE RESULT
# ----------------------------------------------------------

print("=" * 65)
print("ROTA SCHEDULING PERIOD")
print("=" * 65)

print(
    "Start Date       :",
    schedule_dates[0].strftime("%A %d %B %Y")
)

print(
    "End Date         :",
